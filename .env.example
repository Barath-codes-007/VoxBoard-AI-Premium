# Optional. Whiteboard, voice and lessons work without any of these.
AI_PROVIDER=none
AI_API_KEY=
VOXBOARD_DB=voxboard.db
# Saved-audio transcription (optional). Set these as environment variables before starting the backend.
STT_PROVIDER=none   # none | openai (any OpenAI-compatible /audio/transcriptions API)
STT_API_KEY=
STT_MODEL=whisper-1
STT_BASE_URL=https://api.openai.com/v1
# Translation (optional): LibreTranslate-compatible server. A server on localhost works without internet.
TRANSLATE_URL=
TRANSLATE_API_KEY=
# Offline transcription (optional): pip install vosk, install ffmpeg, put Vosk model folders in backend/models
VOSK_MODELS_DIR=
# Backend CORS: comma-separated frontend origins. Default * allows any origin (fine for development).
CORS_ORIGINS=*
